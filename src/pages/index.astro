---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import { alphabet, vowels, consonants } from '../data/alphabet';
import { rules } from '../data/rules';
import { Spell, spell } from '../data/spell';

const sentence = [
  { form: 'Mi', sense: 'I' },
  { form: 'ama', sense: 'love' },
  { form: 'dunia!', sense: 'world' },
];
---

<Base
  title="Amadunia"
  description="A world auxiliary language built from the easiest features of all languages. Nineteen letters, no exceptions."
>
  <section class="hero">
    <div class="wrap">
      <h1 class="gloss">
        {
          sentence.map((word, i) => (
            <span class="gloss__unit">
              <span class="gloss__form" lang="art-x-amadunia">{word.form}</span>
              <span class="gloss__sense" style={`--i:${i}`}>
                {word.sense}
              </span>
            </span>
          ))
        }
      </h1>
      <p class="hero__lede">
        Amadunia takes the easiest feature from every language it can find and leaves the rest
        behind. {Spell(alphabet.length)} letters, one sound each, and a grammar short enough to
        read in an afternoon.
      </p>
      <p class="actions">
        <a class="btn btn--solid" href="/learn/">Start learning</a>
        <a class="btn btn--ghost" href="/grammar/">Read the grammar</a>
      </p>
    </div>
  </section>

  <section class="band">
    <div class="wrap band__grid">
      <p class="rail">
        <span class="rail__name">Alphabet</span>
        <span class="rail__count">{alphabet.length} letters</span>
      </p>
      <div>
        <h2 class="h-section">The whole alphabet fits on one line.</h2>
        <p class="lede">
          {Spell(vowels.length)} vowels and {spell(consonants.length)} consonants. Every letter is
          pronounced, always the same way, in every word.
        </p>
      </div>
    </div>
    <div class="wrap band__full">
      <div class="alphabet-scroll">
        <div class="alphabet">
          {
            alphabet.map((letter) => (
              <a class="letter" href={`/alphabet/#${letter.glyph}`}>
                <span class="letter__glyph" lang="art-x-amadunia">{letter.glyph}</span>
                <span class="letter__sound">{letter.ipa}</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Band name="Grammar" count={`${rules.length} rules`}>
    <h2 class="h-section">Every rule holds. That is the whole design.</h2>
    <p class="lede">
      A language earns its exceptions over centuries. Amadunia has not spent them. If a word would
      need a rule of its own, it does not get in.
    </p>
    <ol class="rules" style="margin-top:2rem">
      {
        rules.slice(0, 4).map((rule) => (
          <li>
            <div>
              <h3 class="rule__claim">{rule.claim}</h3>
              <p class="rule__body">{rule.body}</p>
              {rule.example && (
                <p class="example">
                  <b lang="art-x-amadunia">{rule.example.form}</b> {rule.example.gloss}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
    <p style="margin-top:1.75rem">
      <a href="/grammar/">See all {rules.length} rules</a>
    </p>
  </Band>

  <Band name="Start here" count="3 ways in">
    <h2 class="h-section">Pick a way in.</h2>
    <ul class="stack" style="margin-top:1.5rem">
      <li>
        <a href="/learn/">
          <span class="stack__title">Lessons</span>
          <span class="stack__note">Ten minutes to your first sentence</span>
        </a>
      </li>
      <li>
        <a href="/dictionary/">
          <span class="stack__title">Dictionary</span>
          <span class="stack__note">Look up a word</span>
        </a>
      </li>
      <li>
        <a href="/about/">
          <span class="stack__title">Why another language</span>
          <span class="stack__note">The case for Amadunia</span>
        </a>
      </li>
    </ul>
  </Band>
</Base>
