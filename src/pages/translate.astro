---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import { rules } from '../data/rules';
import { translate as ruleTranslate } from '../lib/translate';
import {
  lexicon,
  corpus,
  englishIndex,
  dictionary,
  translationAccuracy,
  assertTranslatorWorks,
  assertNumerals,
  LANG_REPO,
} from '../lib/lang';

assertNumerals();
assertTranslatorWorks();

const acc = translationAccuracy();
const pairs = corpus().length;
const words = englishIndex().length;
const roots = dictionary().length;

const pc = (o: { ok: number; n: number }) => Math.round((100 * o.ok) / o.n);

// Worked examples, rendered into the page rather than produced in the browser:
// the English is chosen, the Amadunia is whatever the rules actually output, so
// these cannot drift away from what the tool does. They are also the only part
// of this page a reader without JavaScript — or a crawler — can see.
const lex = lexicon() as never;
const SHOWCASE: [string, string][] = [
  ['I eat bread', 'Word order is English\u2019s. Nothing is added.'],
  ['The child did not sleep', 'no goes in front of the predicate, before the tense particle'],
  ['My friend\u2019s house is big', 'the owner follows the thing owned, and no copula before an adjective'],
  ['your friend\u2019s child\u2019s name', 'possession chains to any depth, innermost owner last'],
  ['I want to eat bread', 'two verbs in a row need nothing between them'],
  ['Where is the market?', 'the question word stands where the answer would'],
  ['Who are you?', 'and es returns, because the answer is a noun'],
  ['I read a book well', 'an adverb comes before the object'],
  ['I read a good book', 'the same word after it is an adjective instead'],
  ['She will speak tomorrow', 'one particle before the verb carries the future'],
  ['I see three children', 'after a number the noun stays single'],
  ['I see the children', 'and doubles when the number is not said'],
];
const examples = SHOWCASE.map(([en, why]) => ({ en, why, am: ruleTranslate(lex, en) }));

const site = Astro.site?.toString() ?? 'https://amadunia.com/';
const ld = [
  {
    '@type': 'WebApplication',
    '@id': `${site}translate/#app`,
    name: 'English → Amadunia translator',
    url: `${site}translate/`,
    applicationCategory: 'ReferenceApplication',
    browserRequirements: 'Requires JavaScript.',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    isAccessibleForFree: true,
    inLanguage: ['en', 'art-x-amadunia'],
    about: { '@id': `${site}#language` },
    license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    description:
      `Translates English into Amadunia by applying the language's own grammar rules. ` +
      `Measured against the ${pairs}-sentence corpus on every build: it reproduces ` +
      `${acc.pct}% of them exactly.`,
  },
];
---

<Base
  title="Translate"
  description={`English into Amadunia, by rule rather than by guess. Measured against all ${pairs} sentences anyone has written in the language: it reproduces ${acc.pct}% of them exactly.`}
  crumbs={[['Translate', '/translate/']]}
  ld={ld}
>
  <Band name="Translate" count={`${acc.pct}% exact`}>
    <h1 class="h-section">English into Amadunia.</h1>
    <p class="lede">
      This applies the grammar rather than looking words up. Amadunia was built with no
      conjugation, no gender, no agreement and no exceptions, which is the one condition under
      which a language can be generated from its own rules — so the hard half here is reading
      the English, not writing the Amadunia.
    </p>

    <form style="margin-top:2rem" role="search" onsubmit="return false">
      <label class="stack__note" for="q">English sentence</label>
      <input
        class="field"
        id="q"
        name="q"
        type="search"
        placeholder="My friend's house is big"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        style="margin-top:0.5rem"
      />
    </form>

    <div id="out" style="margin-top:2rem"></div>

    <noscript>
      <p class="stack__note">
        The box above needs JavaScript. The worked examples below are rendered into the page and
        need none.
      </p>
    </noscript>

    <p class="stack__note try-row">
      Try
      <button class="try" type="button">I want to eat bread</button>
      <button class="try" type="button">Where is the market?</button>
      <button class="try" type="button">your friend's child's name</button>
      <button class="try" type="button">The children did not sleep</button>
      <button class="try" type="button">Who are you?</button>
    </p>
  </Band>

  <Band name="Worked" count={`${examples.length} rules`}>
    <h2 class="h-section">What it does, one rule at a time.</h2>
    <p class="lede">
      The English is chosen; the Amadunia is whatever the rules produce at build time. If a rule
      changes, these change with it.
    </p>
    <dl class="gloss-list gloss-list--wide" style="margin-top:2rem">
      {
        examples.map((e) => (
          <>
            <dt>{e.en}</dt>
            <dd>
              <span lang="art-x-amadunia">{e.am}</span>
              <span class="gloss-list__none"> — {e.why}</span>
            </dd>
          </>
        ))
      }
    </dl>
  </Band>

  <Band name="Measured" count={`${acc.exact} of ${acc.total}`}>
    <h2 class="h-section">How often it is right.</h2>
    <p class="lede">
      Every sentence anyone has written in Amadunia is a test case with a known answer. The rules
      run against all {acc.total} of them on every build, and this is the score — not a claim
      written down once and left there.
    </p>

    <ul class="stack" style="margin-top:2rem">
      <li>
        <span class="stack__inert entry">
          <span class="entry__word">{pc(acc.by.grammar)}%</span>
          <span class="entry__meaning">the grammar pages' own examples</span>
          <span class="entry__sources">{acc.by.grammar.ok} of {acc.by.grammar.n}</span>
        </span>
      </li>
      <li>
        <span class="stack__inert entry">
          <span class="entry__word">{pc(acc.by.lessons)}%</span>
          <span class="entry__meaning">the twenty-six lessons</span>
          <span class="entry__sources">{acc.by.lessons.ok} of {acc.by.lessons.n}</span>
        </span>
      </li>
      <li>
        <span class="stack__inert entry">
          <span class="entry__word">{pc(acc.by.phrasebook)}%</span>
          <span class="entry__meaning">the phrasebook</span>
          <span class="entry__sources">{acc.by.phrasebook.ok} of {acc.by.phrasebook.n}</span>
        </span>
      </li>
      <li>
        <span class="stack__inert entry">
          <span class="entry__word">{pc(acc.by.texts)}%</span>
          <span class="entry__meaning">the original texts</span>
          <span class="entry__sources">{acc.by.texts.ok} of {acc.by.texts.n}</span>
        </span>
      </li>
    </ul>

    <p style="margin-top:2rem">
      <strong>It falls off with length, not with difficulty.</strong> Sentences of three words or
      fewer come out right {pc(acc.len.short)}% of the time, four to six words {pc(acc.len.medium)}%,
      seven or more {pc(acc.len.long)}%. That gradient is the English side failing rather than the
      Amadunia side: the longer the English, the more ways there are to misread which word belongs
      to which. The rules that write the Amadunia do not get harder.
    </p>
  </Band>

  <Band name="Limits">
    <h2 class="h-section">What it cannot decide.</h2>
    <p class="lede">
      Some of what it gets wrong is not a bug, and saying which is the difference between a tool
      and a demonstration.
    </p>

    <dl class="notes">
      <dt>English cannot say which "we" you mean</dt>
      <dd>
        <span lang="art-x-amadunia">kita</span> includes the person you are talking to and
        <span lang="art-x-amadunia">mi-mi</span> does not. English has one word for both, so no
        rule can recover the difference. The lessons use both; this page has to pick one.
      </dd>
      <dt>Doubling is a choice, not an ending</dt>
      <dd>
        A bare noun is neutral rather than singular, so doubling is used only when more than one
        actually matters. <span lang="art-x-amadunia">Ain ta kabir</span> — her eyes are big —
        does not double, and is not wrong for leaving it out.
      </dd>
      <dt>Where a frequency adverb stands is still open</dt>
      <dd>
        <a href="/grammar/adverbs/">Upstream has measured the question and not yet decided it</a>,
        so nothing here places <span lang="art-x-amadunia">daima</span> or
        <span lang="art-x-amadunia">kadang</span> with confidence. A tool that guessed would be
        settling a question by accident.
      </dd>
      <dt>A word the dictionary does not hold stays in English</dt>
      <dd>
        It is left in place rather than replaced with something close. The dictionary is closed at
        {roots} roots, and a word it lacks gets
        <a href="/dictionary/#wanted">written down as wanted</a> instead of invented.
      </dd>
    </dl>

    <p style="margin-top:2rem">
      This is a rule engine rather than a machine-learning system, and the difference is worth
      stating plainly. A statistical translator needs hundreds of thousands of sentence pairs;
      Amadunia has {pairs}. What it has instead is a complete grammar — {rules.length} rules with
      no exceptions in them — which is precisely the thing a statistical system spends those
      hundreds of thousands of pairs trying to infer. That is why rules work here and would not
      work for English.
    </p>

    <div class="panel" style="margin-top:2rem">
      <p>
        The word list is <a href="/dictionary/">the dictionary</a> — {words} English entries, each
        with the word class read off the dictionary's own headings, published at
        <a href="/index-english.json">/index-english.json</a>. The test set is
        <a href="/data/">the corpus</a>. The rules are
        <a href={LANG_REPO}>the grammar pages</a>, each cited where it is applied in the source.
        All CC BY-SA 4.0.
      </p>
    </div>
  </Band>
</Base>

<script>
  import { translate, type Lexicon } from '../lib/translate';

  const q = document.getElementById('q') as HTMLInputElement | null;
  const out = document.getElementById('out');

  if (q && out) {
    type Pair = { am: string; en: string; src: string };
    let lex: Lexicon | null = null;
    let sentences: Pair[] = [];
    let loading: Promise<void> | null = null;

    const load = () =>
      (loading ??= (async () => {
        const [idx, tsv] = await Promise.all([
          fetch('/index-english.json').then((r) => r.json()),
          fetch('/corpus.tsv').then((r) => r.text()),
        ]);
        const en: Record<string, string> = {};
        for (const e of idx.entries as { en: string; am: string[] }[]) en[e.en] ??= e.am[0];
        lex = { en, pos: idx.pos, num: idx.numerals, names: idx.names };
        sentences = tsv
          .split('\n')
          .slice(1)
          .filter(Boolean)
          .map((line) => {
            const cell = line.split('\t');
            return { am: cell[0], en: cell[1], src: cell[2] };
          });
      })());

    const esc = (s: string) =>
      s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);

    // A word left in English is shown as it stands, outside the language's colour.
    const result = (s: string) =>
      s
        .split(/(⟨[^⟩]+⟩)/)
        .map((part) =>
          part.startsWith('⟨')
            ? `<span class="gap">${esc(part.slice(1, -1))}</span>`
            : part
              ? `<span lang="art-x-amadunia">${esc(part)}</span>`
              : '',
        )
        .join('');

    const sourceLink = (src: string) => {
      const id = src.replace(/^.*\//, '').replace(/\.md$/, '');
      if (src.startsWith('lessons/')) return `/learn/${id}/`;
      if (src.startsWith('texts/')) return `/texts/${id}/`;
      if (src.startsWith('grammar/')) return `/grammar/${id}/`;
      return '/phrasebook/';
    };

    const render = (text: string) => {
      if (!text.trim() || !lex) {
        out.innerHTML = '';
        return;
      }
      const am = translate(lex, text);
      const missing = [...am.matchAll(/⟨([^⟩]+)⟩/g)].map((m) => m[1]);

      // The corpus is the evidence. If somebody has already written it, say so.
      const terms = [...new Set(text.toLowerCase().match(/[a-z']+/g) ?? [])];
      const phrase = text.toLowerCase().trim().replace(/[.?!]+$/, '');
      const found = sentences
        .map((p) => {
          const en = p.en.toLowerCase();
          return {
            p,
            hits: terms.filter((t) => en.includes(t)).length,
            exact: en.replace(/[.?!]+$/, '') === phrase || en.includes(phrase),
          };
        })
        .filter((s) => s.hits > 0)
        .sort(
          (a, b) =>
            Number(b.exact) - Number(a.exact) ||
            b.hits - a.hits ||
            a.p.en.length - b.p.en.length,
        )
        .slice(0, 6);

      const attested = found[0]?.exact ? found[0].p : null;
      const agrees =
        attested && attested.am.trim().toLowerCase() === am.trim().toLowerCase();

      out.innerHTML = [
        `<p class="result">${result(am)}</p>`,
        attested
          ? `<p class="stack__note">${
              agrees
                ? 'Somebody has written this sentence, and the rules agree with them.'
                : `Somebody wrote this as <span lang="art-x-amadunia">${esc(
                    attested.am,
                  )}</span>. Where they differ, they are right and this is a rule doing its best.`
            } <a href="${sourceLink(attested.src)}">${esc(
              attested.src.replace(/\.md$/, ''),
            )}</a></p>`
          : '',
        missing.length
          ? `<p class="stack__note">Left in English, because the dictionary has no entry for
             <strong>${missing.map(esc).join(', ')}</strong>.</p>`
          : '',
        found.length
          ? `<h3 class="h-sub">Sentences already written</h3>
             <ul class="stack">${found
               .map(
                 ({ p }) => `<li><span class="stack__inert entry">
                   <span class="entry__word"><span lang="art-x-amadunia">${esc(
                     p.am,
                   )}</span></span>
                   <span class="entry__meaning">${esc(p.en)}</span>
                   <span class="entry__sources"><a href="${sourceLink(p.src)}">${esc(
                     p.src.replace(/\.md$/, ''),
                   )}</a></span></span></li>`,
               )
               .join('')}</ul>`
          : '',
      ].join('');
    };

    const preset = new URLSearchParams(location.search).get('q');
    if (preset) q.value = preset;

    let timer: number | undefined;
    const run = async () => {
      await load();
      render(q.value);
    };
    q.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(run, 120);
    });
    if (preset) run();
    for (const b of document.querySelectorAll('.try')) {
      b.addEventListener('click', () => {
        q.value = b.textContent?.trim() ?? '';
        run();
        q.focus();
      });
    }
  }
</script>
