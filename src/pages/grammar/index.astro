---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Band from '../../components/Band.astro';
import { rules } from '../../data/rules';
import { titleOf, statusOf, openQuestionsOf, readmeStatus, questionDemand, LANG_REPO } from '../../lib/lang';
import { spell } from '../../data/spell';

const ORDER = [
  'phonology', 'pronunciation', 'numbers', 'tense', 'plural', 'possession', 'definiteness', 'word-formation', 'questions',
  'pronouns', 'copula', 'negation', 'conjunction', 'demonstratives', 'place', 'verb-chains',
  'comparison', 'subordination', 'adverbs',
];
const all = (await getCollection('grammar')).map((e) => ({
  id: e.id,
  title: titleOf(e.body ?? ''),
  status: statusOf(e.body ?? ''),
  open: openQuestionsOf(e.body ?? ''),
  proposal: e.id.startsWith('proposal-'),
}));

const proposals = all
  .filter((d) => d.proposal)
  .map((d) => ({ ...d, title: d.title.replace(/^Proposal:\s*/, '') }))
  .sort((a, b) => a.title.localeCompare(b.title));

const docs = all
  .filter((d) => !d.proposal)
  .sort((a, b) => {
    const ia = ORDER.indexOf(a.id), ib = ORDER.indexOf(b.id);
    if (ia !== -1 || ib !== -1) return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
    return a.title.localeCompare(b.title);
  });
const openTotal = docs.reduce((n, d) => n + d.open, 0);
const { grammar } = readmeStatus();
const withOpen = docs.filter((d) => d.open > 0);
const demand = questionDemand();
const reached = demand.rows.filter((r) => r.pages > 0);
const unreached = demand.rows.filter((r) => r.pages === 0);
---

<Base
  crumbs={[["Grammar", "/grammar/"]]}
  title="Grammar"
  description={`The grammar of Amadunia, topic by topic: ${docs.map((d) => d.title.toLowerCase()).join(', ')}. Every rule holds everywhere.`}
>
  <Band name="Grammar" count={`${docs.length} topics`}>
    <h1 class="h-section">The grammar, topic by topic.</h1>
    <p class="lede">
      One file per decision, each recording what was settled, why, which candidates were rejected
      and on what ground. {grammar}
    </p>
    <ul class="stack" style="margin-top:2rem">
      {
        docs.map((d) => (
          <li>
            <a href={`/grammar/${d.id}/`}>
              <span class="stack__title">{d.title}</span>
              <span class="stack__note">
                {d.status ?? 'draft'}
                {d.open > 0 && ` · ${d.open} open`}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Band>

  <Band name="At a glance" count={`${rules.length} rules`}>
    <h2 class="h-section">Every rule holds. That is the whole design.</h2>
    <ol class="rules" style="margin-top:1.5rem">
      {
        rules.map((rule) => (
          <li>
            <div>
              <h3 class="rule__claim">
                <a href={rule.href}>{rule.claim}</a>
              </h3>
              <p class="rule__body">{rule.body}</p>
              {rule.example && (
                <p class="example">
                  <b lang="art-x-amadunia">{rule.example.form}</b> {rule.example.gloss}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </Band>

  <Band name="Undecided" count={proposals.length === 1 ? '1 proposal' : `${proposals.length} proposals`}>
    <h2 class="h-section">Questions with a briefing, waiting on a decision.</h2>
    <p class="lede">
      Each of these lays out one open question — what the gap costs, what the candidates are, and
      what each would break — so it can be settled in one sitting. None of them is a rule.
    </p>
    <ul class="stack" style="margin-top:2rem">
      {
        proposals.map((d) => (
          <li>
            <a href={`/grammar/${d.id}/`}>
              <span class="stack__title">{d.title}</span>
              <span class="stack__note">proposal</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Band>

  <Band name="Still open" count={`${openTotal} questions`}>
    <h2 class="h-section">Loose ends inside settled rules.</h2>
    <p class="lede">
      Details a settled rule has not had to answer yet — <em>very</em>, <em>never</em>, the
      superlative of a named group. Each is recorded at the foot of the rule it would belong to.
    </p>
    <ul class="stack" style="margin-top:2rem">
      {
        withOpen.map((d) => (
          <li>
            <a href={`/grammar/${d.id}/#open-questions`}>
              <span class="stack__title">{d.title}</span>
              <span class="stack__note">{d.open === 1 ? '1 question' : `${d.open} questions`}</span>
            </a>
          </li>
        ))
      }
    </ul>

    {
      reached.length > 0 && (
        <>
          <h3 class="h-sub">Which of them the writing has asked for</h3>
          <p class="lede">
            A narrow measure, and the useful one: a page that tried to say something and stopped,
            recorded at the time in a text's gaps or the phrasebook.
            {unreached.length > 0 &&
              ` ${unreached.length} of the questions have never been reached for by anything anyone wrote — an argument about order, not about dropping them.`}
          </p>
          <ul class="stack" style="margin-top:1.5rem">
            {reached.map((r) => (
              <li>
                <span class="stack__inert demand">
                  <span class="demand__question">{r.question}</span>
                  <span class="demand__count">{r.pages === 1 ? '1 page' : `${r.pages} pages`}</span>
                  <span class="demand__sources">
                    {r.sources.map((s, i) => (
                      <>
                        {i > 0 && ', '}
                        {s.href ? <a href={s.href}>{s.label}</a> : s.label}
                      </>
                    ))}
                  </span>
                </span>
              </li>
            ))}
          </ul>
          <p class="source" style="margin-top:1.5rem">
            Counted upstream{demand.asOf && ` ${demand.asOf}`}, and not machine-checked — the
            language repository keeps this table by hand and says so. A question absent from it was
            not blocked while writing; that is not the same as being small.
          </p>
        </>
      )
    }
    <div class="panel" style="margin-top:2rem">
      <p>
        Decisions are made in the open, in the
        <a href={`${LANG_REPO}/issues`}>language repository</a>, and the four with a briefing are
        listed above.
      </p>
    </div>
  </Band>
</Base>
