---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { titleOf, statusOf, openQuestionsOf, LANG_REPO } from '../../lib/lang';

export async function getStaticPaths() {
  const docs = await getCollection('grammar');
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const body = entry.body ?? '';
const title = titleOf(body);
const isProposal = entry.id.startsWith('proposal-');
const status = statusOf(body) ?? (isProposal ? 'proposal — not a rule' : undefined);
const open = openQuestionsOf(body);
const { Content } = await render(entry);
const site = Astro.site?.toString() ?? 'https://amadunia.com/';
const ld = [
  {
    '@type': 'Article',
    '@id': `${site}grammar/${entry.id}/#article`,
    headline: `${title} in Amadunia`,
    about: { '@id': `${site}#language` },
    inLanguage: 'en',
    author: { '@id': `${site}#author` },
    license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    isPartOf: { '@id': `${site}#website` },
    mainEntityOfPage: `${site}grammar/${entry.id}/`,
  },
];
---

<Base title={title} description={`${title} in Amadunia — ${status ?? 'draft'}. The rule, where it comes from, and what was rejected.`} ld={ld} crumbs={[['Grammar', '/grammar/'], [title, `/grammar/${entry.id}/`]]}>
  <section class="band">
    <div class="wrap band__grid">
      <p class="rail">
        <span class="rail__name"><a href="/grammar/">Grammar</a></span>
        <span class="rail__count">{status ?? 'draft'}{open > 0 && ` · ${open} open`}</span>
      </p>
      <div>
        <h1 class="h-section">{title}</h1>
        <article class="prose">
          <Content />
        </article>
        <p class="source">
          Source: <a href={`${LANG_REPO}/blob/main/grammar/${entry.id}.md`}>grammar/{entry.id}.md</a> in the language repository.
        </p>
      </div>
    </div>
  </section>
</Base>
