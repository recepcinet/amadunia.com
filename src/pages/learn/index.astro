---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Band from '../../components/Band.astro';
import { titleOf, lessonNumber, splitLessonTitle, newWordsOf, readingLadder } from '../../lib/lang';
import { dictionary } from '../../lib/lang';

const lessons = (await getCollection('lessons'))
  .map((e) => ({ id: e.id, n: lessonNumber(e.id), ...splitLessonTitle(titleOf(e.body ?? '')), words: newWordsOf(e.body ?? '') }))
  .sort((a, b) => a.n - b.n);
const roots = dictionary().length;
const ladder = readingLadder();
const site = Astro.site?.toString() ?? 'https://amadunia.com/';
const ld = [
  {
    '@type': 'Course',
    '@id': `${site}learn/#course`,
    name: 'Learn Amadunia',
    description: `${lessons.length} short lessons from the first greeting to questions and pronouns.`,
    provider: { '@id': `${site}#author` },
    inLanguage: 'en',
    teaches: 'Amadunia (art-x-amadunia)',
    isAccessibleForFree: true,
    license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    hasPart: lessons.map((l) => ({ '@type': 'LearningResource', '@id': `${site}learn/${l.id}/`, name: `${l.label}: ${l.name}`, url: `${site}learn/${l.id}/` })),
  },
];
---

<Base title="Learn" description={`Learn Amadunia in ${lessons.length} short lessons, from the first greeting to past, future and plural.`} ld={ld} crumbs={[['Learn', '/learn/']]}>
  <Band name="Learn" count={`${lessons.length} lessons`}>
    <h1 class="h-section">Ten minutes to your first sentence.</h1>
    <p class="lede">
      Each lesson adds a few words and at most one rule, and ends with a conversation you can hold.
      Everything in them uses only settled vocabulary — {roots} roots so far.
    </p>
    <ol class="rules" style="margin-top:2.25rem">
      {
        lessons.map((l) => (
          <li>
            <div>
              <h2 class="rule__claim">
                <a href={`/learn/${l.id}/`}>{l.name}</a>
              </h2>
              <p class="rule__body">{l.words === 0 ? 'No new words' : l.words === 1 ? 'One new word' : `${l.words} new words`}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Band>

  {
    ladder.firstLessonShare && (
      <Band name="Reading" count={`${ladder.firstLessonShare} after one lesson`}>
        <h2 class="h-section">When you can start reading.</h2>
        <p class="lede">
          After the first lesson you already know {ladder.firstLessonShare} of every word in the
          texts — the frequency curve doing the work, since ten roots carry a third of everything
          written.
          {ladder.earliest && ladder.earliestText &&
            ` ${ladder.earliestText} opens first, after Lesson ${ladder.earliest}${
              ladder.nextEarliest ? `, and the next after Lesson ${ladder.nextEarliest}` : ''
            }.`}
        </p>
        <p style="margin-top:1.5rem">
          <a href="/learn/reading-ladder/">See the reading ladder</a> — measured from the course
          itself, lesson by lesson.
        </p>
      </Band>
    )
  }

  <Band name="Before you start">
    <h2 class="h-section">Two pages worth reading first.</h2>
    <ul class="stack" style="margin-top:1.5rem">
      <li>
        <a href="/alphabet/">
          <span class="stack__title">The alphabet</span>
          <span class="stack__note">One letter, one sound</span>
        </a>
      </li>
      <li>
        <a href="/grammar/">
          <span class="stack__title">The grammar</span>
          <span class="stack__note">Short enough for one sitting</span>
        </a>
      </li>
    </ul>
  </Band>
</Base>
