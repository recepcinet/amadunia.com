---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { titleOf, lessonNumber, splitLessonTitle, LANG_REPO } from '../../lib/lang';

export async function getStaticPaths() {
  const docs = (await getCollection('lessons')).sort((a, b) => lessonNumber(a.id) - lessonNumber(b.id));
  return docs.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: docs[i - 1] ?? null, next: docs[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { label, name } = splitLessonTitle(titleOf(entry.body ?? ''));
const { Content } = await render(entry);
const nameOf = (e: typeof entry) => splitLessonTitle(titleOf(e.body ?? '')).name;
const site = Astro.site?.toString() ?? 'https://amadunia.com/';
const ld = [
  {
    '@type': 'LearningResource',
    '@id': `${site}learn/${entry.id}/`,
    name: `${label}: ${name}`,
    learningResourceType: 'lesson',
    educationalLevel: 'beginner',
    inLanguage: 'en',
    teaches: 'Amadunia (art-x-amadunia)',
    isPartOf: { '@id': `${site}learn/#course` },
    isAccessibleForFree: true,
    license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    author: { '@id': `${site}#author` },
  },
];
---

<Base title={`${label}: ${name}`} description={`${label} of Amadunia — ${name}. New words, the pattern, a conversation, and practice.`} ld={ld} crumbs={[['Learn', '/learn/'], [label, `/learn/${entry.id}/`]]}>
  <section class="band">
    <div class="wrap band__grid">
      <p class="rail">
        <span class="rail__name"><a href="/learn/">Learn</a></span>
        <span class="rail__count">{label}</span>
      </p>
      <div>
        <h1 class="h-section">{name}</h1>
        <article class="prose">
          <Content />
        </article>
        <nav class="pager" aria-label="Lessons">
          {prev ? <a href={`/learn/${prev.id}/`}>Previous: {nameOf(prev)}</a> : <span />}
          {next ? <a href={`/learn/${next.id}/`}>Next: {nameOf(next)}</a> : <a href="/dictionary/">Next: the dictionary</a>}
        </nav>
        <p class="source">
          Source: <a href={`${LANG_REPO}/blob/main/lessons/${entry.id}.md`}>lessons/{entry.id}.md</a> in the language repository.
        </p>
      </div>
    </div>
  </section>
</Base>
