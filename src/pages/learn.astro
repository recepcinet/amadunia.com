---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';

// PLACEHOLDER COURSE — replace with the real lessons.
const lessons = [
  { n: 1, title: 'Say your first sentence', note: 'In preparation' },
  { n: 2, title: 'The nineteen sounds', note: 'In preparation' },
  { n: 3, title: 'Naming things', note: 'In preparation' },
  { n: 4, title: 'Talking about yesterday and tomorrow', note: 'In preparation' },
  { n: 5, title: 'Asking a question', note: 'In preparation' },
];
---

<Base
  title="Learn"
  description="Learn Amadunia from the first sentence. A short course, written to be finished."
>
  <Band name="Learn" count={`${lessons.length} lessons`}>
    <h1 class="h-section">Ten minutes to your first sentence.</h1>
    <p class="lede">
      The course is short because the language is. Each lesson adds one rule and a handful of
      words, and ends with a sentence you can say out loud.
    </p>

    <ol class="rules" style="margin-top:2.25rem">
      {
        lessons.map((lesson) => (
          <li>
            <div>
              <h2 class="rule__claim">{lesson.title}</h2>
              <p class="rule__body">{lesson.note}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Band>

  <Band name="Meanwhile">
    <h2 class="h-section">While the lessons are being written.</h2>
    <ul class="stack" style="margin-top:1.5rem">
      <li>
        <a href="/alphabet/">
          <span class="stack__title">Learn the alphabet</span>
          <span class="stack__note">19 letters, one sound each</span>
        </a>
      </li>
      <li>
        <a href="/grammar/">
          <span class="stack__title">Read the grammar</span>
          <span class="stack__note">Short enough for one sitting</span>
        </a>
      </li>
    </ul>
  </Band>
</Base>
