---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import { dictionaryGroups, readmeStatus, LANG_REPO } from '../lib/lang';

const groups = dictionaryGroups();
const roots = groups.reduce((n, g) => n + g.entries.length, 0);
const { target, milestones } = readmeStatus();
const nextMilestone = milestones.find((m) => m > roots);
---

<Base
  title="Dictionary"
  description={`Every Amadunia word settled so far — ${roots} roots with their meanings and source languages, searchable.`}
>
  <Band name="Dictionary" count={`${roots} roots`}>
    <h1 class="h-section">Every word settled so far.</h1>
    <p class="lede">
      {roots} roots, on the way to {target} for A1. The source languages are listed with each word
      because global balance is a rule, and this is where it gets checked.
      {nextMilestone && ` Next milestone: ${nextMilestone}.`}
    </p>

    <form style="margin-top:2rem" role="search" onsubmit="return false">
      <label class="stack__note" for="q">Search Amadunia, English, or a source language</label>
      <input class="field" id="q" name="q" type="search" placeholder="dunia" lang="art-x-amadunia" autocomplete="off" style="margin-top:0.5rem" />
    </form>

    <div id="groups">
      {
        groups.map((g) => (
          <section class="group" data-group>
            <h2 class="group__name">{g.name}</h2>
            <ul class="stack">
              {g.entries.map((e) => (
                <li data-word={`${e.word} ${e.meaning} ${e.sources}`.toLowerCase()}>
                  <span class="stack__inert entry">
                    <span class="entry__word" lang="art-x-amadunia">{e.word}</span>
                    <span class="entry__meaning">{e.meaning}</span>
                    <span class="entry__sources">{e.sources && e.sources !== '—' ? e.sources : 'source not yet documented'}</span>
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
    <p class="stack__note" id="empty" hidden style="margin-top:1.5rem">
      No word matches that yet. Propose it in the
      <a href={`${LANG_REPO}/issues`}>language repository</a>.
    </p>
  </Band>

  <Band name="Contributing">
    <h2 class="h-section">Add a word.</h2>
    <div class="panel">
      <p>
        Every entry needs a form, a meaning, and its source languages. A word gets in when it is
        already at home in several language families and collides with nothing settled. Open an
        issue or a pull request on <a href={`${LANG_REPO}/blob/main/dictionary/dictionary.md`}>dictionary.md</a>.
      </p>
    </div>
  </Band>
</Base>

<script>
  const input = document.getElementById('q') as HTMLInputElement | null;
  const empty = document.getElementById('empty');
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    for (const g of groups) {
      let inGroup = 0;
      g.querySelectorAll<HTMLLIElement>('li[data-word]').forEach((li) => {
        const hit = !q || (li.dataset.word ?? '').includes(q);
        li.hidden = !hit;
        if (hit) inGroup += 1;
      });
      g.hidden = inGroup === 0;
      shown += inGroup;
    }
    if (empty) empty.hidden = shown > 0;
  });
</script>
