---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';

// PLACEHOLDER ENTRIES — replace with the real word list.
const entries = [
  { word: 'ama', pos: 'verb', sense: 'to love' },
  { word: 'dunia', pos: 'noun', sense: 'world' },
  { word: 'mi', pos: 'pronoun', sense: 'I, me' },
];
---

<Base
  title="Dictionary"
  description="Look up a word in Amadunia. The word list is being compiled in the open."
>
  <Band name="Dictionary" count={`${entries.length} words`}>
    <h1 class="h-section">Look up a word.</h1>
    <p class="lede">
      The word list is small on purpose and grows slowly. A word gets in when it earns its place
      against the ones already here.
    </p>

    <form style="margin-top:2rem" role="search" onsubmit="return false">
      <label class="stack__note" for="q">Search Amadunia or English</label>
      <input class="field" id="q" name="q" type="search" placeholder="dunia" autocomplete="off" style="margin-top:0.5rem" />
    </form>

    <ul class="stack" id="results" style="margin-top:2rem">
      {
        entries.map((entry) => (
          <li data-word={`${entry.word} ${entry.sense}`}>
            <span class="stack__inert">
              <span class="stack__title">
                {entry.word} <span class="stack__note">{entry.pos}</span>
              </span>
              <span class="stack__note">{entry.sense}</span>
            </span>
          </li>
        ))
      }
    </ul>
    <p class="stack__note" id="empty" hidden style="margin-top:1.5rem">
      No word matches that yet. Propose it in the
      <a href="https://github.com/recepcinet/amadunia.com/issues">issue tracker</a>.
    </p>
  </Band>

  <Band name="Contributing">
    <h2 class="h-section">Add a word.</h2>
    <div class="panel">
      <p>
        Every entry needs a form, a part of speech, a sense in English, and a reason it cannot be
        built from words already in the list. Open an issue with those four things and it will be
        reviewed.
      </p>
    </div>
  </Band>
</Base>

<script>
  const input = document.getElementById('q') as HTMLInputElement | null;
  const list = document.getElementById('results');
  const empty = document.getElementById('empty');

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    list?.querySelectorAll<HTMLLIElement>('li').forEach((li) => {
      const hit = !q || (li.dataset.word ?? '').toLowerCase().includes(q);
      li.hidden = !hit;
      if (hit) shown += 1;
    });
    if (empty) empty.hidden = shown > 0;
  });
</script>
