---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import { getCollection } from 'astro:content';
import { dictionaryGroups, readmeStatus, wantedWords, markAmadunia, titleOf, LANG_REPO } from '../lib/lang';

const groups = dictionaryGroups();
const roots = groups.reduce((n, g) => n + g.entries.length, 0);
const { next } = readmeStatus();
const wanted = wantedWords();
const docs = (await getCollection('dictionaryDocs'))
  .map((e) => ({ id: e.id, title: titleOf(e.body ?? ''), proposal: e.id.startsWith('proposal-') }))
  .sort((a, b) => Number(a.proposal) - Number(b.proposal));

const site = Astro.site?.toString() ?? 'https://amadunia.com/';
const ld = [
  {
    '@type': 'DefinedTermSet',
    '@id': `${site}dictionary/#terms`,
    name: 'Amadunia dictionary',
    inLanguage: 'art-x-amadunia',
    license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    hasDefinedTerm: groups.flatMap((g) =>
      g.entries.map((e) => ({
        '@type': 'DefinedTerm',
        name: e.word,
        description: e.meaning,
        inLanguage: 'art-x-amadunia',
        termCode: e.group,
        inDefinedTermSet: `${site}dictionary/#terms`,
      })),
    ),
  },
];
---

<Base
  title="Dictionary"
  description={`Every Amadunia word settled so far — ${roots} roots with their meanings and source languages, searchable.`}
  ld={ld}
  crumbs={[['Dictionary', '/dictionary/']]}
>
  <Band name="Dictionary" count={`${roots} roots`}>
    <h1 class="h-section">Every word settled so far.</h1>
    <p class="lede">
      {roots} roots{next && `, on the way to ${next.roots}${next.level ? ` for ${next.level}` : ''}`}. The
      source languages are listed with each word because global balance is a rule, and this is
      where it gets checked.
    </p>

    <form style="margin-top:2rem" role="search" onsubmit="return false">
      <label class="stack__note" for="q">Search Amadunia, English, or a source language</label>
      <input class="field" id="q" name="q" type="search" placeholder="dunia" lang="art-x-amadunia" autocomplete="off" style="margin-top:0.5rem" />
    </form>

    <div id="groups">
      {
        groups.map((g) => (
          <section class="group" data-group>
            <h2 class="group__name">{g.name}</h2>
            <ul class="stack">
              {g.entries.map((e) => (
                <li data-word={`${e.word} ${e.meaning} ${e.sources}`.toLowerCase()}>
                  <span class="stack__inert entry">
                    <span class="entry__word" lang="art-x-amadunia">{e.word}</span>
                    <span class="entry__meaning">{e.meaning}</span>
                    <span class="entry__sources">{e.sources && e.sources !== '—' ? e.sources : 'source not yet documented'}</span>
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
    <p class="stack__note" id="empty" hidden style="margin-top:1.5rem">
      No word matches that yet. Propose it in the
      <a href={`${LANG_REPO}/issues`}>language repository</a>.
    </p>
  </Band>

  {
    wanted.length > 0 && (
      <Band name="Wanted" id="wanted" count={`${wanted.length} words`}>
        <h2 class="h-section">Words the writing has asked for.</h2>
        <p class="lede">
          Not suggestions. Each one is a place where a text or the phrasebook tried to say
          something ordinary and stopped, and the sentence that stopped is on record. A gap found
          by writing is worth more than a gap found by reading a wordlist.
        </p>
        <ul class="stack" style="margin-top:2rem">
          {wanted.map((w) => (
            <li>
              <span class="stack__inert entry">
                <span class="entry__word">{w.word}</span>
                <span class="entry__meaning">
                  {markAmadunia(w.sentence).map((p) =>
                    p.am ? <span lang="art-x-amadunia">{p.text}</span> : p.text,
                  )}
                </span>
                <span class="entry__sources">
                  {w.foundByHref ? <a href={w.foundByHref}>{w.foundBy}</a> : w.foundBy}
                </span>
              </span>
            </li>
          ))}
        </ul>
      </Band>
    )
  }

  {
    docs.length > 0 && (
      <Band name="Counted" count={`${docs.length} papers`}>
        <h2 class="h-section">The word list, measured.</h2>
        <p class="lede">
          Global balance is design rule 4, and the one easiest to claim without keeping. It is
          counted over the whole dictionary rather than batch by batch, and what the next three
          hundred roots should be made of is argued from those numbers.
        </p>
        <ul class="stack" style="margin-top:2rem">
          {docs.map((d) => (
            <li>
              <a href={`/dictionary/${d.id}/`}>
                <span class="stack__title">{d.title}</span>
                <span class="stack__note">{d.proposal ? 'briefing — nothing adopted' : 'measured'}</span>
              </a>
            </li>
          ))}
        </ul>
      </Band>
    )
  }

  <Band name="Contributing">
    <h2 class="h-section">Add a word.</h2>
    <div class="panel">
      <p>
        Every entry needs a form, a meaning, and its source languages. A word gets in when it is
        already at home in several language families and collides with nothing settled. Open an
        issue or a pull request on <a href={`${LANG_REPO}/blob/main/dictionary/dictionary.md`}>dictionary.md</a>.
      </p>
    </div>
  </Band>
</Base>

<script>
  const input = document.getElementById('q') as HTMLInputElement | null;
  const empty = document.getElementById('empty');
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    for (const g of groups) {
      let inGroup = 0;
      g.querySelectorAll<HTMLLIElement>('li[data-word]').forEach((li) => {
        const hit = !q || (li.dataset.word ?? '').includes(q);
        li.hidden = !hit;
        if (hit) inGroup += 1;
      });
      g.hidden = inGroup === 0;
      shown += inGroup;
    }
    if (empty) empty.hidden = shown > 0;
  });
</script>
