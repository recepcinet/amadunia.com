---
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import Colophon from '../components/Colophon.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = title === 'Amadunia' ? title : `${title} — Amadunia`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@85..125,400..700&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Masthead />
    <main id="main">
      <slot />
    </main>
    <Colophon />
  </body>
</html>
