---
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import Colophon from '../components/Colophon.astro';
import { countEndpoint } from '../lib/analytics';

interface Props {
  title: string;
  description: string;
  /** Extra schema.org nodes for this page, merged into the @graph. */
  ld?: Record<string, unknown>[];
  /** Breadcrumb trail below the home page, e.g. [['Learn', '/learn/'], ['Lesson 1', '/learn/lesson-1/']]. */
  crumbs?: [string, string][];
}

const { title, description, ld = [], crumbs = [] } = Astro.props;
const pageTitle = title === 'Amadunia' ? title : `${title} — Amadunia`;
const url = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

// Structured data: the site, the language it documents, and this page.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#website`,
      url: Astro.site,
      name: 'Amadunia',
      description:
        'A world auxiliary language built from the easiest features of all languages. One sound per letter, no exceptions.',
      inLanguage: 'en',
      about: { '@id': `${Astro.site}#language` },
      author: { '@id': `${Astro.site}#author` },
      license: 'https://opensource.org/licenses/MIT',
    },
    {
      '@type': 'Language',
      '@id': `${Astro.site}#language`,
      name: 'Amadunia',
      alternateName: 'art-x-amadunia',
      description:
        'A constructed international auxiliary language. Latin script without accents or digraphs; spelling and pronunciation never diverge; the grammar admits no exceptions.',
      url: Astro.site,
    },
    {
      '@type': 'Person',
      '@id': `${Astro.site}#author`,
      name: 'Recep Cinet',
      url: 'https://github.com/recepcinet',
    },
    {
      '@type': 'WebPage',
      '@id': url.toString(),
      url: url.toString(),
      name: pageTitle,
      description,
      isPartOf: { '@id': `${Astro.site}#website` },
      about: { '@id': `${Astro.site}#language` },
      inLanguage: 'en',
      primaryImageOfPage: ogImage.toString(),
      ...(crumbs.length ? { breadcrumb: { '@id': `${url}#breadcrumb` } } : {}),
    },
    ...(crumbs.length
      ? [
          {
            '@type': 'BreadcrumbList',
            '@id': `${url}#breadcrumb`,
            itemListElement: [['Amadunia', '/'], ...crumbs].map(([name, path], i) => ({
              '@type': 'ListItem',
              position: i + 1,
              name,
              item: new URL(path, Astro.site).toString(),
            })),
          },
        ]
      : []),
    ...ld,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#faf7f0" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="alternate" type="application/json" href="/dictionary.json" title="Amadunia dictionary" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Amadunia" />
    <meta property="og:locale" content="en" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mi ama dunia! — I love the world, in Amadunia." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@85..125,400..700&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&display=swap"
    />
    {
      countEndpoint && (
        <script
          data-goatcounter={countEndpoint}
          data-goatcounter-settings='{"allow_local": false}'
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Masthead />
    <main id="main">
      <slot />
    </main>
    <Colophon />
  </body>
</html>
