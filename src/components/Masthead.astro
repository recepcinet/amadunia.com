---
// Writing is a proposal upstream; the link appears with the folder.
import { hasWriting } from '../lib/lang';

const links = [
  { href: '/alphabet/', label: 'Alphabet' },
  { href: '/grammar/', label: 'Grammar' },
  { href: '/dictionary/', label: 'Dictionary' },
  { href: '/translate/', label: 'Translate' },
  { href: '/learn/', label: 'Learn' },
  { href: '/phrasebook/', label: 'Phrasebook' },
  { href: '/texts/', label: 'Texts' },
  { href: '/data/', label: 'Data' },
  ...(hasWriting ? [{ href: '/writing/', label: 'Writing' }] : []),
  { href: '/about/', label: 'About' },
];

const here = Astro.url.pathname;
---

<header class="masthead">
  <div class="wrap masthead__inner">
    <a class="wordmark" href="/" lang="art-x-amadunia">amadunia</a>
    <nav class="nav" aria-label="Main">
      {
        links.map((link) => (
          <a href={link.href} aria-current={here.startsWith(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
